# В production используйте неизменяемый digest образа из registry.
SSO_IMAGE=
SSO_EDGE_NETWORK=production-edge

# По возможности используйте управляемый PostgreSQL с проверкой сертификата.
SSO_DATABASE_URL=

# Сгенерируйте случайное значение, например: openssl rand -base64 48
SSO_ENCRYPTION_KEY=

SSO_ISSUER=https://sso.example.org
SSO_CORS_ALLOWED_ORIGINS=https://sso.example.org
SSO_TRUSTED_PROXIES=172.20.0.0/16

SSO_SMTP_HOST=smtp.example.org
SSO_SMTP_PORT=587
SSO_SMTP_USERNAME=
SSO_SMTP_PASSWORD=
SSO_SMTP_FROM=sso@example.org

# Use an immutable registry digest in production.
SSO_IMAGE=
SSO_EDGE_NETWORK=production-edge

# Use a managed PostgreSQL endpoint with certificate verification whenever possible.
SSO_DATABASE_URL=

# Generate independent values, for example with: openssl rand -base64 48
SSO_JWT_SECRET=
SSO_ENCRYPTION_KEY=

SSO_ISSUER=https://sso.example.org
SSO_CORS_ALLOWED_ORIGINS=https://sso.example.org
SSO_TRUSTED_PROXIES=172.20.0.0/16

SSO_SMTP_HOST=smtp.example.org
SSO_SMTP_PORT=587
SSO_SMTP_USERNAME=
SSO_SMTP_PASSWORD=
SSO_SMTP_FROM=sso@example.org

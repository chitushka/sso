SSO_ENV=local
SSO_HTTP_ADDR=:8080
SSO_DATABASE_URL=postgres://sso:sso@postgres:5432/sso?sslmode=disable
SSO_ENCRYPTION_KEY=change-me-please-change-me-please-change-me
# Одноразовый параметр для `sso-api rotate-encryption-key`; не задавайте при обычном запуске.
# SSO_NEW_ENCRYPTION_KEY=replace-with-an-independent-random-key
SSO_ACCESS_TOKEN_TTL=15m
SSO_SESSION_TTL=720h
SSO_REFRESH_TOKEN_TTL=720h
SSO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
SSO_ISSUER=http://localhost:8080
SSO_LOG_LEVEL=info
# SMTP необязателен только при локальной разработке; сообщения никогда не записываются в журналы.
SSO_SMTP_HOST=
SSO_SMTP_PORT=587
SSO_SMTP_USERNAME=
SSO_SMTP_PASSWORD=
SSO_SMTP_FROM=
SSO_SMTP_STARTTLS=true
# Применять миграции при запуске для разработки. В production с отдельным шагом миграции оставьте false.
SSO_MIGRATE_ON_START=false
# CIDR/IP доверенных reverse proxy для X-Forwarded-For через запятую. Пусто — не доверять никому и использовать RemoteAddr.
SSO_TRUSTED_PROXIES=
